<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows on Android 12+: the widget as it looks, with example numbers. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_label"
        android:textColor="@color/widget_primary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_amount"
        android:textColor="@color/widget_ink"
        android:textSize="30sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="@string/widget_preview_line"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_pill"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="@string/widget_preview_cash"
        android:textColor="@color/widget_on_primary"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
