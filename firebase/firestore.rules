rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function usernameDoc(name) {
      return /databases/$(database)/documents/usernames/$(name);
    }

    function profileDoc(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // usernames/{username} -> { uid, email }
    // Anyone may look up a single name (login by username needs the email before signing in),
    // but nobody can list them. A claim is written in the same transaction as the profile, which
    // is what limits each account to one username.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;

      allow create: if signedIn()
        && username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && !exists(profileDoc(request.auth.uid))
        && getAfter(profileDoc(request.auth.uid)).data.username == username;

      allow update: if false;
      // Only together with the profile (deleting the account), so a profile never points at a
      // name someone else could then claim.
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && !existsAfter(profileDoc(request.auth.uid));
    }

    // users/{uid}: the profile, plus the account's backup under it.
    match /users/{uid} {
      allow read: if isUser(uid);

      allow create: if isUser(uid)
        && request.resource.data.keys().hasOnly(['username', 'email', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && getAfter(usernameDoc(request.resource.data.username)).data.uid == uid;

      // The username is fixed once claimed. `backup` is the account-wide cloud backup switch.
      allow update: if isUser(uid)
        && request.resource.data.username == resource.data.username
        && request.resource.data.keys().hasOnly(['username', 'email', 'createdAt', 'backup'])
        && request.resource.data.get('backup', true) is bool;
      allow delete: if isUser(uid);

      // The backup: parsed fields only. Each collection lists the fields it may hold, so raw SMS or
      // notification text can't be stored even by mistake. Collections not listed are closed.
      match /transactions/{id} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && synced([
            'amountPaise', 'direction', 'type', 'timestamp', 'vpa', 'payeeRaw', 'merchantId',
            'accountLast4', 'bankCode', 'upiRef', 'balanceAfterPaise', 'categoryId', 'confidence',
            'status', 'sources', 'note', 'tags', 'createdAt', 'items'
          ])
          && request.resource.data.amountPaise is int
          // A broken-down payment's items ({ id, amountPaise, categoryId, note }) live in its document.
          && request.resource.data.get('items', []) is list
          && request.resource.data.get('items', []).size() <= 50
          && lastFourAtMost(request.resource.data.get('accountLast4', null));
      }

      match /categories/{id} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && synced(['name', 'emoji', 'colorArgb', 'monthlyBudgetPaise', 'sortOrder', 'isSystem']);
      }

      match /merchants/{id} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && synced(['vpa', 'displayName', 'defaultCategoryId', 'timesSeen']);
      }

      match /rules/{id} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && synced(['field', 'match', 'pattern', 'categoryId', 'priority']);
      }

      match /myAccounts/{id} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && synced(['match', 'value', 'role', 'label']);
      }

      match /budgets/{id} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && synced(['period', 'amountPaise', 'allowanceDay', 'dailyFoodCapPaise'])
          && request.resource.data.amountPaise is int;
      }
    }

    // A synced document: only the given fields plus the sync ones, and stamped with the server's
    // clock (other devices page through syncedAt, so it can't be left to the phone).
    function synced(fields) {
      let data = request.resource.data;
      return data.keys().hasOnly(fields.concat(['updatedAt', 'deleted', 'syncedAt']))
        && data.updatedAt is int
        && data.deleted is bool
        && data.syncedAt == request.time
        // Last write wins: an edit older than the stored one is turned away.
        && (resource == null || data.updatedAt >= resource.data.updatedAt);
    }

    // Account numbers leave the phone as their last four digits at most.
    function lastFourAtMost(value) {
      return value == null || (value is string && value.size() <= 4);
    }

    // sharedSplits/{id} -> { memberUids[], payerUid, total, shares{uid: paise}, settled{uid: bool}, note, createdAt }
    // A bill split between friends who all use Inkless. Only its members see it, only the payer
    // creates or removes it, and each member can only tick their own share as settled.
    match /sharedSplits/{splitId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['memberUids', 'payerUid', 'total', 'shares', 'settled', 'note', 'createdAt'])
        && request.resource.data.payerUid == request.auth.uid
        && request.resource.data.memberUids is list
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.total is int
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && request.auth.uid in resource.data.memberUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settled'])
        && request.resource.data.settled.diff(resource.data.settled).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.settled[request.auth.uid] is bool;

      allow delete: if signedIn() && resource.data.payerUid == request.auth.uid;
    }
  }
}
